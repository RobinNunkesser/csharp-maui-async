<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsyncRecipe.MainPage"
             Title="Async Todo Loader"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="15"
            VerticalOptions="Center">

            <Label
                Text="Async / Await Example"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Click 'Load Todos' to async load data from a simulated remote service."
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Opacity="0.6" />

            <!-- Loading Indicator -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}"
                Scale="1.5" />

            <!-- Status Message -->
            <Label
                Text="Loading..."
                IsVisible="{Binding IsBusy}"
                FontSize="12"
                HorizontalOptions="Center"
                Opacity="0.7" />

            <!-- Error Message -->
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding ErrorMessage, StringFormat='{0}', FallbackValue=false}"
                TextColor="Red"
                FontSize="12"
                Padding="10"
                Margin="0,10" />

            <!-- Control Buttons -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button
                    Text="Load Todos"
                    Command="{Binding LoadTodosCommand}"
                    Padding="15,10" />

                <Button
                    Text="Cancel"
                    Command="{Binding CancelLoadCommand}"
                    BackgroundColor="#FFC0CB"
                    Padding="15,10" />
            </HorizontalStackLayout>

            <!-- Todo List -->
            <CollectionView
                ItemsSource="{Binding Todos}"
                Margin="0,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            ColumnDefinitions="*,50"
                            ColumnSpacing="10"
                            Padding="15,10"
                            RowSpacing="5">

                            <VerticalStackLayout Grid.Column="0">
                                <Label
                                    Text="{Binding Title}"
                                    FontSize="14"
                                    FontAttributes="Bold" />
                                <Label
                                    Text="{Binding IsCompleted, StringFormat='Status: {0}'}"
                                    FontSize="12"
                                    Opacity="0.7" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="✓"
                                FontSize="18"
                                Padding="5"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleTodoCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
